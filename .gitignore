# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/

# Virtual environments
venv/
.venv/
env/
ENV/

# Logs
logs/*
!logs/.gitkeep

# Output files
output/csv/*
output/excel/*
!output/csv/.gitkeep
!output/excel/.gitkeep

# Temporary Excel files
~$*.xlsx
~$*.xls
~$*.xlsm

# IDE files
.idea/
.vscode/
*.swp
*.swo

# OS specific files
.DS_Store
Thumbs.db

# Data files (contain sensitive business data)
data/
!data/.gitkeep

# Test data
test_data/

# Test scripts
test_*.py

# Scripts directory (seems to contain temporary scripts)
scripts/

# Archive folders
output/archive/
